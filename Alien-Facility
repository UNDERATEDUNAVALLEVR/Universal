-- Main RenderStepped Target Loop
game:GetService('RunService').RenderStepped:Connect(function()
    local localPlayer = game:GetService('Players').LocalPlayer
    local statusEffects = game:GetService("ReplicatedStorage"):FindFirstChild("ReplicatedStatusEffects")

    for _, v in ipairs(game:GetService('Players'):GetPlayers()) do
        if v ~= localPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = v.Character.HumanoidRootPart
            
            if getgenv().HitboxStatus then
                local shouldExpand = false

                if not getgenv().TeamCheck then
                    shouldExpand = true
                else
                    -- Check 1: ReplicatedStorage Status
                    local isRebelRS = false
                    if statusEffects and statusEffects:FindFirstChild(v.Name) then
                        if statusEffects[v.Name]:FindFirstChild("REBEL") then
                            isRebelRS = true
                        end
                    end

                    -- Check 2: Character Billboard GUI
                    local isRebelCharacter = false
                    if hrp:FindFirstChild("RebelBillBoardGui") then
                        isRebelCharacter = true
                    end

                    local isRebel = isRebelRS or isRebelCharacter
                    
                    -- Team Identification
                    local targetTeamName = v.Team and string.lower(v.Team.Name) or ""
                    local isTargetAlien = string.find(targetTeamName, "alien") ~= nil

                    if isTargetAlien then
                        -- Alien logic: Expand if Rebel OR if TargetGoodAliens option is toggled on
                        if isRebel or getgenv().TargetGoodAliens then
                            shouldExpand = true
                        else
                            shouldExpand = false
                        end
                    else
                        -- Non-Alien team check
                        if localPlayer.Team ~= v.Team then
                            shouldExpand = true
                        end
                    end
                end

                if shouldExpand then
                    pcall(function()
                        hrp.Size = Vector3.new(getgenv().HitboxSize, getgenv().HitboxSize, getgenv().HitboxSize)
                        hrp.Transparency = getgenv().HitboxTransparency
                        hrp.BrickColor = BrickColor.new("Really black")
                        hrp.Material = Enum.Material.Neon
                        hrp.CanCollide = false
                    end)
                else
                    -- Reset non-targets (Good Aliens / Teammates)
                    pcall(function()
                        hrp.Size = Vector3.new(2, 2, 1)
                        hrp.Transparency = 1
                        hrp.BrickColor = BrickColor.new("Medium stone grey")
                        hrp.Material = Enum.Material.Plastic
                        hrp.CanCollide = false
                    end)
                end
            else
                -- Hitbox Disabled - Reset All
                pcall(function()
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                    hrp.BrickColor = BrickColor.new("Medium stone grey")
                    hrp.Material = Enum.Material.Plastic
                    hrp.CanCollide = false
                end)
            end
        end
    end
end)
