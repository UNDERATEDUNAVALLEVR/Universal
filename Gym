-- Button Functions
local function flashButton(button, actionText)
    button.BackgroundColor3 = Color3.fromRGB(74, 112, 74) -- Muted green (#4a704a)
    statusLabel.Text = "Gym: " .. actionText
    statusLabel.TextColor3 = Color3.fromRGB(74, 112, 74) -- Muted green (#4a704a)
    task.wait(0.5)
    button.BackgroundColor3 = Color3.fromRGB(42, 42, 42) -- Dark gray (#2a2a2a)
    statusLabel.Text = "Gym: Idle"
    statusLabel.TextColor3 = Color3.fromRGB(112, 74, 74) -- Muted red (#704a4a)
end

addWeightButton.MouseButton1Click:Connect(function()
    pcall(function()
        local remote = game:GetService("Players").LocalPlayer.PlayerGui.StrengthGui.Frame.AddWeightButton.LocalScript.RemoteEvent
        remote:FireServer()
        flashButton(addWeightButton, "Added Weight")
    end, function(err)
        statusLabel.Text = "Error: Add failed"
    end)
end)

minusWeightButton.MouseButton1Click:Connect(function()
    pcall(function()
        local remote = game:GetService("Players").LocalPlayer.PlayerGui.StrengthGui.Frame.SubtractWeightButton.LocalScript.RemoteEvent
        remote:FireServer()
        flashButton(minusWeightButton, "Removed Weight")
    end, function(err)
        statusLabel.Text = "Error: Minus failed"
    end)
end)

leaveButton.MouseButton1Click:Connect(function()
    pcall(function()
        local remote = game:GetService("Players").LocalPlayer.PlayerGui.StrengthGui.Frame.LeaveButton.LocalScript.RemoteEvent
        remote:FireServer()
        flashButton(leaveButton, "Left Training")
    end, function(err)
        statusLabel.Text = "Error: Leave failed"
    end)
end)

