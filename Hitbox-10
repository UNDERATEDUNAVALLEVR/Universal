end)

-- Auto-update hitbox size as the user types
sizeInput:GetPropertyChangedSignal("Text"):Connect(function()
    local input = tonumber(sizeInput.Text)
    if input and input >= 1 and input <= 100 then
        HeadSize = input
        print("Set HeadSize to: " .. HeadSize)
        updateAllOverlays() -- Update overlays immediately
    else
        print("Invalid input (temporary): " .. tostring(sizeInput.Text))
    end
end)

-- When the user finishes typing (e.g., loses focus), ensure the TextBox shows the correct value
sizeInput.FocusLost:Connect(function()
    sizeInput.Text = tostring(HeadSize)
end)

-- Handle character added/respawn
local function onCharacterAdded(player, character)
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if hrp then
        if IsEnabled then
            local localPlayer = Players.LocalPlayer
            local localTeam = localPlayer and localPlayer.Team
            if not IsTeamCheckEnabled or (localTeam and player.Team ~= localTeam) then
                createHitboxOverlay(player, hrp)
            end
        end
    else
        print("No HumanoidRootPart found for " .. player.Name)
    end
end

-- Connect character added for all players
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= Players.LocalPlayer then
        if player.Character then
            onCharacterAdded(player, player.Character)
        end
        player.CharacterAdded:Connect(function(character)
            onCharacterAdded(player, character)
        end)
    end
end

-- Handle new players joining
Players.PlayerAdded:Connect(function(player)
    if player ~= Players.LocalPlayer then
        player.CharacterAdded:Connect(function(character)
            onCharacterAdded(player, character)
        end)
    end
end)

-- Handle players leaving
Players.PlayerRemoving:Connect(function(player)
    removeHitboxOverlay(player)
end)

