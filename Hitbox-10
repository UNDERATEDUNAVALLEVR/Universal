local HeadSize = 10
local IsEnabled = true
local IsTeamCheckEnabled = false

local defaultSize = Vector3.new(2, 2, 1)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local hitboxOverlays = {}

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "HitboxToggleUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 150, 0, 140)
frame.Position = UDim2.new(0, 10, 0, 10)
frame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
frame.BackgroundTransparency = 0.2
frame.Parent = screenGui
frame.Draggable = true
frame.Active = true

local frameCorner = Instance.new("UICorner")
frameCorner.CornerRadius = UDim.new(0, 8)
frameCorner.Parent = frame

local toggleButton = Instance.new("TextButton")
toggleButton.Name = "Toggle"
toggleButton.Size = UDim2.new(0, 120, 0, 40)
toggleButton.Position = UDim2.new(0, 15, 0, 10)
toggleButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleButton.Font = Enum.Font.SourceSansBold
toggleButton.TextSize = 20
toggleButton.Text = "Hitbox: ON"
toggleButton.Parent = frame
toggleButton.Active = true
toggleButton.Selectable = true

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(0, 8)
toggleCorner.Parent = toggleButton

local sizeInput = Instance.new("TextBox")
sizeInput.Size = UDim2.new(0, 120, 0, 30)
sizeInput.Position = UDim2.new(0, 15, 0, 55)
sizeInput.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
sizeInput.TextColor3 = Color3.fromRGB(255, 255, 255)
sizeInput.Font = Enum.Font.SourceSans
sizeInput.TextSize = 18
sizeInput.Text = tostring(HeadSize)
sizeInput.PlaceholderText = "Size (e.g., 10)"
sizeInput.Parent = frame

local inputCorner = Instance.new("UICorner")
inputCorner.CornerRadius = UDim.new(0, 8)
inputCorner.Parent = sizeInput

local teamCheckButton = Instance.new("TextButton")
teamCheckButton.Name = "TeamCheckToggle"
teamCheckButton.Size = UDim2.new(0, 120, 0, 40)
teamCheckButton.Position = UDim2.new(0, 15, 0, 90)
teamCheckButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
teamCheckButton.TextColor3 = Color3.fromRGB(255, 255, 255)
teamCheckButton.Font = Enum.Font.SourceSansBold
teamCheckButton.TextSize = 20
teamCheckButton.Text = "Team Check: OFF"
teamCheckButton.Parent = frame
teamCheckButton.Active = true
teamCheckButton.Selectable = true

local teamCheckCorner = Instance.new("UICorner")
teamCheckCorner.CornerRadius = UDim.new(0, 8)
teamCheckCorner.Parent = teamCheckButton

local buttonDebounce = false
toggleButton.MouseButton1Click:Connect(function()
    if buttonDebounce then return end
    buttonDebounce = true
    IsEnabled = not IsEnabled
    toggleButton.Text = IsEnabled and "Hitbox: ON" or "Hitbox: OFF"
    print("Toggled hitbox: " .. (IsEnabled and "ON" or "OFF"))
    task.wait(0.2)
    buttonDebounce = false
end)

teamCheckButton.MouseButton1Click:Connect(function()
    if buttonDebounce then return end
    buttonDebounce = true
    IsTeamCheckEnabled = not IsTeamCheckEnabled
    teamCheckButton.Text = IsTeamCheckEnabled and "Team Check: ON" or "Team Check: OFF"
    print("Toggled team check: " .. (IsTeamCheckEnabled and "ON" or "OFF") .. " (LocalPlayer team: " .. (Players.LocalPlayer.Team and Players.LocalPlayer.Team.Name or "nil") .. ")")
    task.wait(0.2)
    buttonDebounce = false
end)

sizeInput:GetPropertyChangedSignal("Text"):Connect(function()
    local input = tonumber(sizeInput.Text)
    if input and input >= 1 and input <= 100 then
        HeadSize = input
        print("Set HeadSize to: " .. HeadSize)
    else
        print("Invalid input: " .. tostring(sizeInput.Text))
    end
end)

sizeInput.FocusLost:Connect(function()
    sizeInput.Text = tostring(HeadSize)
end)

local function createHitboxOverlay(player, hrp)
    if hitboxOverlays[player] then
        hitboxOverlays[player]:Destroy()
        hitboxOverlays[player] = nil
    end

    if not IsEnabled then return end

    local overlay = Instance.new("Part")
    overlay.Name = "HitboxOverlay"
    overlay.Size = Vector3.new(HeadSize, HeadSize, HeadSize)
    overlay.Position = hrp.Position
    overlay.Transparency = 0.7
    overlay.BrickColor = BrickColor.new("Really blue")
    overlay.Material = Enum.Material.Neon
    overlay.CanCollide = false
    overlay.Anchored = true
    overlay.Parent = workspace

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = hrp
    weld.Part1 = overlay
    weld.Parent = overlay

    hitboxOverlays[player] = overlay
    print("Created hitbox overlay for " .. player.Name)
end

local function removeHitboxOverlay(player)
    if hitboxOverlays[player] then
        hitboxOverlays[player]:Destroy()
        hitboxOverlays[player] = nil
        print("Removed hitbox overlay for " .. player.Name)
    end
end

local function resetHitbox(player, hrp)
    hrp.Size = defaultSize
    hrp.Transparency = 0
    hrp.BrickColor = BrickColor.new("Medium stone grey")
    hrp.Material = Enum.Material.Plastic
    hrp.CanCollide = true
    removeHitboxOverlay(player)
end

local function onCharacterAdded(player, character)
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if hrp then
        local localTeam = Players.LocalPlayer.Team
        if IsEnabled and (not IsTeamCheckEnabled or (localTeam and player.Team == localTeam)) then
            createHitboxOverlay(player, hrp)
        end
    else
        print("No HumanoidRootPart for " .. player.Name)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= Players.LocalPlayer then
        if player.Character then
            onCharacterAdded(player, player.Character)
        end
        player.CharacterAdded:Connect(function(character)
            onCharacterAdded(player, character)
        end)
    end
end

Players.PlayerAdded:Connect(function(player)
    if player ~= Players.LocalPlayer then
        player.CharacterAdded:Connect(function(character)
            onCharacterAdded(player, character)
        end)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    removeHitboxOverlay(player)
end)

RunService.RenderStepped:Connect(function()
    local localPlayer = Players.LocalPlayer
    if not localPlayer then
        print("LocalPlayer not found")
        return
    end

    local localTeam = localPlayer.Team

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            local char = player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if IsEnabled and (not IsTeamCheckEnabled or (localTeam and player.Team == localTeam)) then
                        hrp.Size = Vector3.new(HeadSize, HeadSize, HeadSize)
                        hrp.Transparency = 0.8
                        hrp.BrickColor = BrickColor.new("Really blue")
                        hrp.Material = Enum.Material.Neon
                        hrp.CanCollide = false
                        if not hitboxOverlays[player] or hitboxOverlays[player].Size ~= Vector3.new(HeadSize, HeadSize, HeadSize) then
                            createHitboxOverlay(player, hrp)
                        end
                    else
                        resetHitbox(player, hrp)
                    end
                end
            end
        end
    end
end)
