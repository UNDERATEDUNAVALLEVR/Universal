-- Universal Team Check Variable
local teamCheckEnabled = true

-- Universal team detection function
local function isEnemy(player)
    if player == localPlayer then
        return false -- Always return false for local player
    end
    
    -- If Team Check is disabled, treat everyone as an enemy
    if not teamCheckEnabled then
        return true
    end
    
    -- Check if the game has teams
    local teamsService = game:GetService("Teams")
    local teams = teamsService:GetTeams()
    if #teams > 1 then
        -- Team-based game
        if localPlayer.Team == nil or player.Team == nil then
            return true  -- Players not in any team are considered enemies
        end
        return localPlayer.Team ~= player.Team
    else
        -- Free-for-all game (no teams)
        return true
    end
end

-- Sound function with better error handling
local function playSound(soundId)
    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Parent = workspace
    
    local success, err = pcall(function()
        sound:Play()
    end)
    
    if not success then
        warn("Failed to play sound: " .. err)
        sound:Destroy()
        return
    end
    
    sound.Ended:Connect(function()
        sound:Destroy()
    end)
end

