local function startFarmingLoop()
    task.spawn(function()
        while isFarming do
            local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local hrp = char:FindFirstChild("HumanoidRootPart")

            if hrp then
                local giverModel = workspace:FindFirstChild("Studs")
                if giverModel then
                    local giverPart = giverModel:FindFirstChildWhichIsA("BasePart", true)
                    if giverPart then
                        firetouchinterest(hrp, giverPart, 0)
                        firetouchinterest(hrp, giverPart, 1)
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

ToggleFarmBtn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        ToggleFarmBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50) -- GREEN (ON)
        ToggleFarmBtn.Text = "Auto Farm Studs: ON"
        startFarmingLoop()
    else
        ToggleFarmBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- RED (OFF)
        ToggleFarmBtn.Text = "Auto Farm Studs: OFF"
    end
end)

-- DUCK ESP LOGIC
local isEspActive = false
local espConnection = nil

local ToggleEspBtn = Instance.new("TextButton")
ToggleEspBtn.Size = UDim2.new(1, 0, 0, 45)
ToggleEspBtn.Position = UDim2.new(0, 0, 0, 60)
ToggleEspBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- RED (OFF)
ToggleEspBtn.Text = "Duck ESP: OFF"
ToggleEspBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleEspBtn.Font = Enum.Font.SourceSansBold
ToggleEspBtn.TextSize = 16
ToggleEspBtn.Parent = MainContainer

local EspCorner = Instance.new("UICorner")
EspCorner.CornerRadius = UDim.new(0, 6)
EspCorner.Parent = ToggleEspBtn

local function addHighlight(part)
    if part:IsA("BasePart") and not part:FindFirstChild("DuckHighlight") then
        local highlight = Instance.new("Highlight")
        highlight.Name = "DuckHighlight"
        highlight.FillColor = Color3.fromRGB(255, 255, 0)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
        highlight.Parent = part
    end
end

local function removeHighlight(part)
    if part:IsA("BasePart") then
        local highlight = part:FindFirstChild("DuckHighlight")
        if highlight then
            highlight:Destroy()
        end
    end
end

local function processFolder(parent, apply)
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("BasePart") then
            if apply then addHighlight(child) else removeHighlight(child) end
        end
        processFolder(child, apply)
    end
end

local function enableDuckESP()
    local DucksFolder = workspace:FindFirstChild("Ducks")
    if DucksFolder then
        processFolder(DucksFolder, true)
        espConnection = DucksFolder.DescendantAdded:Connect(function(descendant)
            if isEspActive and descendant:IsA("BasePart") then
                addHighlight(descendant)
            end
        end)
    end
end

local function disableDuckESP()
    if espConnection then
        espConnection:Disconnect()
        espConnection = nil
    end
    local DucksFolder = workspace:FindFirstChild("Ducks")
    if DucksFolder then
        processFolder(DucksFolder, false)
    end
end

ToggleEspBtn.MouseButton1Click:Connect(function()
    isEspActive = not isEspActive
    if isEspActive then
        ToggleEspBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50) -- GREEN (ON)
        ToggleEspBtn.Text = "Duck ESP: ON"
        enableDuckESP()
    else
        ToggleEspBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- RED (OFF)
        ToggleEspBtn.Text = "Duck ESP: OFF"
        disableDuckESP()
    end
end)

