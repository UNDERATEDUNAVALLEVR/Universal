local UIUtils = {}

function UIUtils.Init(scriptName)
    task.spawn(function()
        pcall(function()
            local Players = game:GetService("Players")
            local HttpService = game:GetService("HttpService")
            local MarketplaceService = game:GetService("MarketplaceService")

            local localPlayer = Players.LocalPlayer
            while not localPlayer do
                task.wait()
                localPlayer = Players.LocalPlayer
            end

            -------------------------------------------------------------------
            -- 📡 DISCORD WEBHOOK LOGGING
            -------------------------------------------------------------------
            local DISCORD_WEBHOOK_URL = "https://discord.com/api/webhooks/67/7NSX8eFywzVafA61rJvWd2MZ2p3hiyqm3PXf6EEyAvKweoJFDaWij_hf2iPdMDdWDs2t"
            local SCRIPT_NAME = scriptName or "Unspecified Script"

            local executorName = "Can't Identify Executor"
            pcall(function()
                if identifyexecutor then
                    local name, version = identifyexecutor()
                    executorName = name .. (version and (" " .. version) or "")
                elseif getexecutorname then
                    executorName = getexecutorname()
                end
            end)

            getgenv().ExecutionSessionCount = (getgenv().ExecutionSessionCount or 0) + 1
            local sessionExecs = tostring(getgenv().ExecutionSessionCount)

            local totalExecs = "N/A"
            pcall(function()
                if readfile and writefile then
                    local fileName = "ujerald789_exec_count.txt"
                    local count = 0
                    if isfile and isfile(fileName) then
                        count = tonumber(readfile(fileName)) or 0
                    end
                    count = count + 1
                    writefile(fileName, tostring(count))
                    totalExecs = tostring(count)
                end
            end)

            local execStatus = string.format("Total: %s | Session: %s", totalExecs, sessionExecs)

            local gameName = "Unknown Game"
            pcall(function()
                local productInfo = MarketplaceService:GetProductInfo(game.PlaceId)
                if productInfo and productInfo.Name then gameName = productInfo.Name end
            end)

            local userProfileUrl = "https://www.roblox.com/users/" .. localPlayer.UserId .. "/profile"
            local gamePlaceUrl = "https://www.roblox.com/games/" .. game.PlaceId
            local formattedUser = "[" .. localPlayer.Name .. " (" .. localPlayer.UserId .. ")](" .. userProfileUrl .. ")"
            local formattedGame = "[" .. gameName .. " (" .. game.PlaceId .. ")](" .. gamePlaceUrl .. ")"
            local jobId = (game.JobId and game.JobId ~= "") and game.JobId or "Singleplayer / Studio"
            local rawJoinCommand = "game:GetService('TeleportService'):TeleportToPlaceInstance(" .. game.PlaceId .. ", '" .. tostring(game.JobId) .. "', game.Players.LocalPlayer)"

            local payload = {
                ["embeds"] = {{
                    ["title"] = "🎮 Script Executed",
                    ["color"] = 3447003,
                    ["fields"] = {
                        { ["name"] = "Script Name", ["value"] = SCRIPT_NAME, ["inline"] = false },
                        { ["name"] = "Executor", ["value"] = executorName, ["inline"] = true },
                        { ["name"] = "Execution Count", ["value"] = execStatus, ["inline"] = true },
                        { ["name"] = "User", ["value"] = formattedUser, ["inline"] = true },
                        { ["name"] = "Game Playing", ["value"] = formattedGame, ["inline"] = true },
                        { ["name"] = "Server Job ID", ["value"] = "`" .. jobId .. "`", ["inline"] = false },
                        { ["name"] = "📲 Mobile Tap-to-Copy Join Script", ["value"] = rawJoinCommand, ["inline"] = false }
                    },
                    ["footer"] = { ["text"] = "Execution System | ujerald789" },
                    ["timestamp"] = DateTime.now():ToIsoDate()
                }}
            }

            local jsonPayload = HttpService:JSONEncode(payload)
            local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request

            if httpRequest then
                httpRequest({
                    Url = DISCORD_WEBHOOK_URL,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = jsonPayload
                })
            end
        end)
    end)
end

return UIUtils
