-- WallHop Script for Roblox (Client-Side, Mobile Friendly)
-- Features: Toggle wallhop (double-jump flick near walls), dark UI (color-matched to WallHop V2), mobile-friendly draggable UI, on/off buttons, destroy button
-- Warning: Modifies character movement; violates Roblox ToS. Test in private server to avoid bans.
-- Optimized for low-end devices (e.g., 3GB RAM phones).

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

-- UI Setup
local screenGui = Instance.new("ScreenGui")
screenGui.Parent = player:WaitForChild("PlayerGui")
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.IgnoreGuiInset = true

local frame = Instance.new("Frame")
frame.Parent = screenGui
frame.Size = UDim2.new(0, 200, 0, 100)
frame.Position = UDim2.new(0.5, -100, 0.5, -50)
frame.BackgroundColor3 = Color3.fromRGB(26, 26, 26) -- Deep charcoal (#1a1a1a)
frame.BorderColor3 = Color3.fromRGB(51, 51, 51) -- Dark gray (#333333)
frame.Active = true
frame.Draggable = true

local onButton = Instance.new("TextButton")
onButton.Parent = frame
onButton.Text = "On"
onButton.Size = UDim2.new(0, 60, 0, 30)
onButton.Position = UDim2.new(0, 20, 0, 20)
onButton.BackgroundColor3 = Color3.fromRGB(42, 42, 42) -- Dark gray (#2a2a2a)
onButton.BorderColor3 = Color3.fromRGB(51, 51, 51) -- Dark gray (#333333)
onButton.TextColor3 = Color3.fromRGB(224, 224, 224) -- Light gray (#e0e0e0)
onButton.TextScaled = true

local offButton = Instance.new("TextButton")
offButton.Parent = frame
offButton.Text = "Off"
offButton.Size = UDim2.new(0, 60, 0, 30)
offButton.Position = UDim2.new(0, 120, 0, 20)
offButton.BackgroundColor3 = Color3.fromRGB(42, 42, 42) -- Dark gray (#2a2a2a)
offButton.BorderColor3 = Color3.fromRGB(51, 51, 51) -- Dark gray (#333333)
offButton.TextColor3 = Color3.fromRGB(224, 224, 224) -- Light gray (#e0e0e0)
offButton.TextScaled = true

local destroyButton = Instance.new("TextButton")
destroyButton.Parent = frame
destroyButton.Text = "Destroy"
destroyButton.Size = UDim2.new(0, 160, 0, 30)
destroyButton.Position = UDim2.new(0, 20, 0, 60)
destroyButton.BackgroundColor3 = Color3.fromRGB(53, 53, 53) -- Slightly lighter gray (#353535)
destroyButton.BorderColor3 = Color3.fromRGB(51, 51, 51) -- Dark gray (#333333)
destroyButton.TextColor3 = Color3.fromRGB(224, 224, 224) -- Light gray (#e0e0e0)
destroyButton.TextScaled = true

local statusLabel = Instance.new("TextLabel")
statusLabel.Parent = frame
statusLabel.Size = UDim2.new(0, 200, 0, 30)
statusLabel.Position = UDim2.new(0, 0, 0, -30)
statusLabel.BackgroundColor3 = Color3.fromRGB(37, 37, 38) -- Slightly lighter dark (#252526)
statusLabel.BorderColor3 = Color3.fromRGB(51, 51, 51) -- Dark gray (#333333)
statusLabel.Text = "WallHop: Off"
statusLabel.TextColor3 = Color3.fromRGB(112, 74, 74) -- Muted red (#704a4a)
statusLabel.TextScaled = true

-- Wallhop Variables
local wallhopEnabled = false
local jumpCount = 0

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Blacklist

-- Wall Check
local function isNearWall()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        statusLabel.Text = "Error: No character"
        return false
    end

    raycastParams.FilterDescendantsInstances = {character}
    local directions = {
        root.CFrame.LookVector,
        -root.CFrame.LookVector,
        root.CFrame.RightVector,
        -root.CFrame.RightVector
    }

    for _, dir in ipairs(directions) do
        local success, result = pcall(function()
            return workspace:Raycast(root.Position, dir * 3, raycastParams)
        end)
        if success and result and result.Instance then
            return true
        elseif not success then
            statusLabel.Text = "Error: Raycast failed"
        end
    end

    return false
end

-- Button Functions
onButton.MouseButton1Click:Connect(function()
    statusLabel.Text = "WallHop: On"
    statusLabel.TextColor3 = Color3.fromRGB(74, 112, 74) -- Muted green (#4a704a)
    onButton.BackgroundColor3 = Color3.fromRGB(74, 112, 74) -- Muted green (#4a704a)
    offButton.BackgroundColor3 = Color3.fromRGB(42, 42, 42) -- Reset to dark gray (#2a2a2a)
    wallhopEnabled = true
end)

offButton.MouseButton1Click:Connect(function()
    statusLabel.Text = "WallHop: Off"
    statusLabel.TextColor3 = Color3.fromRGB(112, 74, 74) -- Muted red (#704a4a)
    offButton.BackgroundColor3 = Color3.fromRGB(112, 74, 74) -- Muted red (#704a4a)
    onButton.BackgroundColor3 = Color3.fromRGB(42, 42, 42) -- Reset to dark gray (#2a2a2a)
    wallhopEnabled = false
end)

destroyButton.MouseButton1Click:Connect(function()
    screenGui:Destroy()
end)

-- Track Jump Count
UserInputService.JumpRequest:Connect(function()
    if not wallhopEnabled then return end

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if humanoid and root then
        jumpCount += 1

        -- Trigger flick ONLY if second jump + near wall
        if jumpCount == 2 and isNearWall() then
            pcall(function()
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                -- Apply rotation flick with sharper angle (70 degrees)
                root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(-70), 0)
                task.wait(0.1)
                root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(70), 0)
                jumpCount = 0
            end, function(err)
                statusLabel.Text = "Error: Flick failed"
            end)
        end
    else
        statusLabel.Text = "Error: No character"
    end
end)

-- Reset Jump Count When Touching Ground
game:GetService("RunService").Heartbeat:Connect(function()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.FloorMaterial ~= Enum.Material.Air then
        jumpCount = 0
    end
end)
