local function setupChar(char)
	character = char
	humanoid = char:WaitForChild("Humanoid")
	hrp = char:WaitForChild("HumanoidRootPart")

	canDodge = true


	local leftAnim = Instance.new("Animation")
	leftAnim.AnimationId = leftdodge

	local rightAnim = Instance.new("Animation")
	rightAnim.AnimationId = rightdodge

	leftTrack = humanoid:LoadAnimation(leftAnim)
	rightTrack = humanoid:LoadAnimation(rightAnim)



	for _, s in ipairs(dodgeSounds) do
		s:Destroy()
	end
	dodgeSounds = {}
	currentSoundIndex = 1


	for _, soundId in ipairs(instinctSounds) do
		local sound = Instance.new("Sound")
		sound.SoundId = soundId
		sound.Volume = 1
		sound.Parent = hrp
		table.insert(dodgeSounds, sound)
	end

end


if player.Character then
	setupChar(player.Character)
end


