local ShiftLockScreenGui = Instance.new("ScreenGui")
local ShiftLockButton = Instance.new("ImageButton")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local Player = Players.LocalPlayer
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")

local States = {
    Off = "rbxasset://textures/ui/mouseLock_off@2x.png",
    On = "rbxasset://textures/ui/mouseLock_on@2x.png"
}
local MaxLength = 900000
local EnabledOffset = CFrame.new(1.7, 0, 0)
local DisabledOffset = CFrame.new(-1.7, 0, 0)
local Active
local isDragging = false
local lastInputPosition = Vector2.new(0, 0)

-- Send Notification
StarterGui:SetCore("SendNotification", {
    Title = "ShiftLock";
    Text = "By ujerald789";
    Icon = "rbxthumb://type=Asset&id=5107182114&w=150&h=150";
    Duration = 3;
})

ShiftLockScreenGui.Name = "Shiftlock (CoreGui)"
ShiftLockScreenGui.Parent = CoreGui
ShiftLockScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ShiftLockScreenGui.ResetOnSpawn = false

ShiftLockButton.Parent = ShiftLockScreenGui
ShiftLockButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
ShiftLockButton.BackgroundTransparency = 1.000
ShiftLockButton.Position = UDim2.new(0.7, 0, 0.75, 0)
ShiftLockButton.Size = UDim2.new(0.0636147112, 0, 0.0661305636, 0)
ShiftLockButton.SizeConstraint = Enum.SizeConstraint.RelativeXX
ShiftLockButton.Image = States.Off

-- Dragging Functionality
local function startDragging(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        lastInputPosition = Vector2.new(input.Position.X, input.Position.Y)
    end
end

local function updateDragging(input)
    if isDragging then
        local currentPosition = Vector2.new(input.Position.X, input.Position.Y)
        local delta = currentPosition - lastInputPosition
        lastInputPosition = currentPosition

        local currentPos = ShiftLockButton.Position
        local newX = currentPos.X.Scale + (delta.X / ShiftLockScreenGui.AbsoluteSize.X)
        local newY = currentPos.Y.Scale + (delta.Y / ShiftLockScreenGui.AbsoluteSize.Y)

        -- Clamp position to stay within screen bounds
        newX = math.clamp(newX, 0, 1 - ShiftLockButton.Size.X.Scale)
        newY = math.clamp(newY, 0, 1 - ShiftLockButton.Size.Y.Scale)

        ShiftLockButton.Position = UDim2.new(newX, 0, newY, 0)
    end
end

local function stopDragging(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
    end
end

ShiftLockButton.InputBegan:Connect(startDragging)
UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        updateDragging(input)
    end
end)
ShiftLockButton.InputEnded:Connect(stopDragging)

-- Shift Lock Functionality
ShiftLockButton.MouseButton1Click:Connect(function()
    if not Active then
        Active = RunService.RenderStepped:Connect(function()
            Player.Character.Humanoid.AutoRotate = false
            ShiftLockButton.Image = States.On
            Player.Character.HumanoidRootPart.CFrame = CFrame.new(
                Player.Character.HumanoidRootPart.Position,
                Vector3.new(
                    workspace.CurrentCamera.CFrame.LookVector.X * MaxLength,
                    Player.Character.HumanoidRootPart.Position.Y,
                    workspace.CurrentCamera.CFrame.LookVector.Z * MaxLength
                )
            )
            workspace.CurrentCamera.CFrame = workspace.CurrentCamera.CFrame * EnabledOffset
            workspace.CurrentCamera.Focus = CFrame.fromMatrix(
                workspace.CurrentCamera.Focus.Position,
                workspace.CurrentCamera.CFrame.RightVector,
                workspace.CurrentCamera.CFrame.UpVector
            ) * EnabledOffset
        end)
    else
        Player.Character.Humanoid.AutoRotate = true
        ShiftLockButton.Image = States.Off
        workspace.CurrentCamera.CFrame = workspace.CurrentCamera.CFrame * DisabledOffset
        pcall(function()
            Active:Disconnect()
            Active = nil
        end)
    end
end)

local function ShiftLock(actionName, inputState, inputObject)
    if inputState == Enum.UserInputState.Begin then
        ShiftLockButton:InputBegan({UserInputType = Enum.UserInputType.MouseButton1})
    end
end

local ShiftLockAction = ContextActionService:BindAction("Shift Lock", ShiftLock, false, "On")
ContextActionService:SetPosition("Shift Lock", UDim2.new(0.8, 0, 0.8, 0))

return {}
