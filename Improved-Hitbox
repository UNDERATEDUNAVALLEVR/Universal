-- Tab Creator
local tabs = {}

local function CreateTab(tabName)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Parent = Sidebar
    tabBtn.Size = UDim2.new(1, 0, 0, 32)
    tabBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 34)
    tabBtn.Text = tabName
    tabBtn.TextColor3 = Color3.fromRGB(150, 150, 170)
    tabBtn.Font = Enum.Font.GothamMedium
    tabBtn.TextSize = 12

    local tabCorner = Instance.new("UICorner")
    tabCorner.CornerRadius = UDim.new(0, 6)
    tabCorner.Parent = tabBtn

    local tabContainer = Instance.new("ScrollingFrame")
    tabContainer.Parent = ContentFolder
    tabContainer.Size = UDim2.new(1, 0, 1, 0)
    tabContainer.BackgroundTransparency = 1
    tabContainer.ScrollBarThickness = 3
    tabContainer.ScrollBarImageColor3 = Color3.fromRGB(110, 85, 235)
    tabContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
    tabContainer.Visible = false

    local cList = Instance.new("UIListLayout")
    cList.Parent = tabContainer
    cList.SortOrder = Enum.SortOrder.LayoutOrder
    cList.Padding = UDim.new(0, 6)

    cList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        tabContainer.CanvasSize = UDim2.new(0, 0, 0, cList.AbsoluteContentSize.Y + 10)
    end)

    tabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.Button.BackgroundColor3 = Color3.fromRGB(24, 24, 34)
            t.Button.TextColor3 = Color3.fromRGB(150, 150, 170)
            t.Container.Visible = false
        end
        tabBtn.BackgroundColor3 = Color3.fromRGB(110, 85, 235)
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        tabContainer.Visible = true
    end)

    local tabData = {Button = tabBtn, Container = tabContainer}
    table.insert(tabs, tabData)

    if #tabs == 1 then
        tabBtn.BackgroundColor3 = Color3.fromRGB(110, 85, 235)
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        tabContainer.Visible = true
    end

    -- Component Generators inside Tab
    local components = {}

    function components:Toggle(text, callback)
        local frame = Instance.new("Frame")
        frame.Parent = tabContainer
        frame.Size = UDim2.new(1, -6, 0, 32)
        frame.BackgroundColor3 = Color3.fromRGB(22, 22, 30)

        local fCorner = Instance.new("UICorner")
        fCorner.CornerRadius = UDim.new(0, 6)
        fCorner.Parent = frame

        local lbl = Instance.new("TextLabel")
        lbl.Parent = frame
        lbl.Size = UDim2.new(1, -45, 1, 0)
        lbl.Position = UDim2.new(0, 10, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 11
        lbl.TextXAlignment = Enum.TextXAlignment.Left

        local switch = Instance.new("Frame")
        switch.Parent = frame
        switch.Size = UDim2.new(0, 30, 0, 18)
        switch.Position = UDim2.new(1, -36, 0.5, -9)
        switch.BackgroundColor3 = Color3.fromRGB(40, 40, 52)

        local bCorner = Instance.new("UICorner")
        bCorner.CornerRadius = UDim.new(0, 9)
        bCorner.Parent = switch

        local clickArea = Instance.new("TextButton")
        clickArea.Parent = frame
        clickArea.Size = UDim2.new(1, 0, 1, 0)
        clickArea.BackgroundTransparency = 1
        clickArea.Text = ""

        local state = false
        clickArea.MouseButton1Click:Connect(function()
            state = not state
            if state then
                switch.BackgroundColor3 = Color3.fromRGB(110, 85, 235)
            else
                switch.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
            end
            callback(state)
        end)
    end

    function components:TextBox(placeholder, callback)
        local box = Instance.new("TextBox")
        box.Parent = tabContainer
        box.Size = UDim2.new(1, -6, 0, 32)
        box.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
        box.PlaceholderText = placeholder
        box.PlaceholderColor3 = Color3.fromRGB(120, 120, 140)
        box.Text = ""
        box.TextColor3 = Color3.fromRGB(255, 255, 255)
        box.Font = Enum.Font.Gotham
        box.TextSize = 11

        local bCorner = Instance.new("UICorner")
        bCorner.CornerRadius = UDim.new(0, 6)
        bCorner.Parent = box

        box.FocusLost:Connect(function()
            callback(box.Text)
        end)
    end

    function components:Button(text, callback)
        local btn = Instance.new("TextButton")
        btn.Parent = tabContainer
        btn.Size = UDim2.new(1, -6, 0, 32)
        btn.BackgroundColor3 = Color3.fromRGB(110, 85, 235)
        btn.Text = text
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 11

        local bCorner = Instance.new("UICorner")
        bCorner.CornerRadius = UDim.new(0, 6)
        bCorner.Parent = btn

        btn.MouseButton1Click:Connect(function()
            callback()
        end)
    end

    function components:Keybind(label, defaultKey, callback)
        local frame = Instance.new("Frame")
        frame.Parent = tabContainer
        frame.Size = UDim2.new(1, -6, 0, 32)
        frame.BackgroundColor3 = Color3.fromRGB(22, 22, 30)

        local fCorner = Instance.new("UICorner")
        fCorner.CornerRadius = UDim.new(0, 6)
        fCorner.Parent = frame

        local lbl = Instance.new("TextLabel")
        lbl.Parent = frame
        lbl.Size = UDim2.new(1, -85, 1, 0)
        lbl.Position = UDim2.new(0, 10, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = label
        lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 11
        lbl.TextXAlignment = Enum.TextXAlignment.Left

        local bindBtn = Instance.new("TextButton")
        bindBtn.Parent = frame
        bindBtn.Size = UDim2.new(0, 70, 0, 22)
        bindBtn.Position = UDim2.new(1, -76, 0.5, -11)
        bindBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
        bindBtn.Text = defaultKey.Name
        bindBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        bindBtn.Font = Enum.Font.GothamBold
        bindBtn.TextSize = 10

        local bCorner = Instance.new("UICorner")
        bCorner.CornerRadius = UDim.new(0, 5)
        bCorner.Parent = bindBtn

        local listening = false

        bindBtn.MouseButton1Click:Connect(function()
            if listening then return end
            listening = true
            bindBtn.Text = "..."
            bindBtn.BackgroundColor3 = Color3.fromRGB(110, 85, 235)

            local connection
            connection = UserInputService.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    listening = false
                    bindBtn.Text = input.KeyCode.Name
                    bindBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
                    connection:Disconnect()
                    callback(input.KeyCode)
                end
            end)
        end)
    end

    return components
end

