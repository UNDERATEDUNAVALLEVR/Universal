-- Function to create or update a hitbox overlay
local function createHitboxOverlay(player, hrp)
    -- Remove existing overlay if it exists
    if hitboxOverlays[player] then
        hitboxOverlays[player]:Destroy()
        hitboxOverlays[player] = nil
    end

    if not IsEnabled then return end

    -- Create a new overlay part
    local overlay = Instance.new("Part")
    overlay.Name = "HitboxOverlay"
    overlay.Size = Vector3.new(HeadSize, HeadSize, HeadSize)
    overlay.Position = hrp.Position
    overlay.Transparency = 0.7
    overlay.BrickColor = BrickColor.new("Really blue")
    overlay.Material = Enum.Material.Neon
    overlay.CanCollide = false
    overlay.Anchored = true
    overlay.Parent = workspace

    -- Weld the overlay to the HumanoidRootPart
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = hrp
    weld.Part1 = overlay
    weld.Parent = overlay

    hitboxOverlays[player] = overlay
    print("Created hitbox overlay for " .. player.Name .. ": Size = " .. HeadSize)
end

-- Function to remove hitbox overlay
local function removeHitboxOverlay(player)
    if hitboxOverlays[player] then
        hitboxOverlays[player]:Destroy()
        hitboxOverlays[player] = nil
        print("Removed hitbox overlay for " .. player.Name)
    end
end

-- Function to update all overlays based on current settings
local function updateAllOverlays()
    local localPlayer = Players.LocalPlayer
    if not localPlayer then
        print("LocalPlayer not found")
        return
    end

    local localTeam = localPlayer.Team

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and (not IsTeamCheckEnabled or player.Team ~= localTeam) then
            local char = player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if IsEnabled then
                        if not hitboxOverlays[player] or hitboxOverlays[player].Size ~= Vector3.new(HeadSize, HeadSize, HeadSize) then
                            createHitboxOverlay(player, hrp)
                        end
                    else
                        removeHitboxOverlay(player)
                    end
                end
            end
        else
            -- Remove overlay if player doesn't meet team check criteria
            removeHitboxOverlay(player)
        end
    end
end

-- Toggle hitbox functionality
