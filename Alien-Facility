-- Main Hitbox Tab
local MainTab = Window:Tab("Hitbox", "rbxassetid://10888331510")

MainTab:InfoLabel("Simple Hitbox Expander")

MainTab:Section("Controls")

MainTab:Toggle("Status: ", function(state)
    getgenv().HitboxStatus = state
end)

MainTab:Toggle("Team Check", function(state)
    getgenv().TeamCheck = state
end)

MainTab:Toggle("Target Good Aliens", function(state)
    getgenv().TargetGoodAliens = state
end)

MainTab:Section("Settings")

MainTab:TextBox("Hitbox Size", function(value)
    local text = type(value) == "table" and value.Text or tostring(value)
    local num = tonumber(text)
    if num and num > 0 then
        getgenv().HitboxSize = num
    end
end)

MainTab:TextBox("Hitbox Transparency", function(number)
    local text = type(number) == "table" and number.Text or tostring(number)
    local num = tonumber(text)
    if num then
        getgenv().HitboxTransparency = math.clamp(num, 0, 1)
    end
end)

MainTab:Keybind("Toggle UI", Enum.KeyCode.F, function()
    Library:ToggleUI()
end)

