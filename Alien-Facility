    Title.TextXAlignment = Enum.TextXAlignment.Left

    -- Sidebar Tab Frame
    local Sidebar = Instance.new("Frame")
    Sidebar.Name = "Sidebar"
    Sidebar.Parent = Window
    Sidebar.Position = UDim2.new(0, 8, 0, 46)
    Sidebar.Size = UDim2.new(0, 85, 1, -54)
    Sidebar.BackgroundTransparency = 1

    local sidebarList = Instance.new("UIListLayout")
    sidebarList.Parent = Sidebar
    sidebarList.SortOrder = Enum.SortOrder.LayoutOrder
    sidebarList.Padding = UDim.new(0, 6)

    -- Tab Content Container
    local ContentFolder = Instance.new("Frame")
    ContentFolder.Name = "ContentFolder"
    ContentFolder.Parent = Window
    ContentFolder.Position = UDim2.new(0, 100, 0, 46)
    ContentFolder.Size = UDim2.new(1, -108, 1, -54)
    ContentFolder.BackgroundTransparency = 1

    -- Toggle Window Visibility
    MobileToggle.MouseButton1Click:Connect(function()
        Window.Visible = not Window.Visible
    end)

    -- Tab Creator
    local tabs = {}
    local activeTab = nil

    local function CreateTab(tabName)
        local tabBtn = Instance.new("TextButton")
        tabBtn.Parent = Sidebar
        tabBtn.Size = UDim2.new(1, 0, 0, 32)
        tabBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 34)
        tabBtn.Text = tabName
        tabBtn.TextColor3 = Color3.fromRGB(150, 150, 170)
        tabBtn.Font = Enum.Font.GothamMedium
        tabBtn.TextSize = 12

        local tabCorner = Instance.new("UICorner")
        tabCorner.CornerRadius = UDim.new(0, 6)
        tabCorner.Parent = tabBtn

        local tabContainer = Instance.new("ScrollingFrame")
        tabContainer.Parent = ContentFolder
        tabContainer.Size = UDim2.new(1, 0, 1, 0)
        tabContainer.BackgroundTransparency = 1
        tabContainer.ScrollBarThickness = 3
        tabContainer.ScrollBarImageColor3 = Color3.fromRGB(110, 85, 235)
        tabContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
        tabContainer.Visible = false

        local cList = Instance.new("UIListLayout")
        cList.Parent = tabContainer
        cList.SortOrder = Enum.SortOrder.LayoutOrder
        cList.Padding = UDim.new(0, 6)

        cList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            tabContainer.CanvasSize = UDim2.new(0, 0, 0, cList.AbsoluteContentSize.Y + 10)
        end)

        tabBtn.MouseButton1Click:Connect(function()
            for _, t in pairs(tabs) do
                t.Button.BackgroundColor3 = Color3.fromRGB(24, 24, 34)
                t.Button.TextColor3 = Color3.fromRGB(150, 150, 170)
                t.Container.Visible = false
            end
            tabBtn.BackgroundColor3 = Color3.fromRGB(110, 85, 235)
            tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            tabContainer.Visible = true
        end)

        local tabData = {Button = tabBtn, Container = tabContainer}
        table.insert(tabs, tabData)

        if #tabs == 1 then
            tabBtn.BackgroundColor3 = Color3.fromRGB(110, 85, 235)
            tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            tabContainer.Visible = true
        end

        -- Component Generators inside Tab
        local components = {}

        function components:Toggle(text, callback)
            local frame = Instance.new("Frame")
            frame.Parent = tabContainer
            frame.Size = UDim2.new(1, -6, 0, 32)
            frame.BackgroundColor3 = Color3.fromRGB(22, 22, 30)

            local fCorner = Instance.new("UICorner")
            fCorner.CornerRadius = UDim.new(0, 6)
            fCorner.Parent = frame

            local lbl = Instance.new("TextLabel")
            lbl.Parent = frame
            lbl.Size = UDim2.new(1, -45, 1, 0)
            lbl.Position = UDim2.new(0, 10, 0, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = text
            lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 11
            lbl.TextXAlignment = Enum.TextXAlignment.Left

            local switch = Instance.new("Frame")
            switch.Parent = frame
            switch.Size = UDim2.new(0, 30, 0, 18)
            switch.Position = UDim2.new(1, -36, 0.5, -9)
            switch.BackgroundColor3 = Color3.fromRGB(40, 40, 52)

            local bCorner = Instance.new("UICorner")
            bCorner.CornerRadius = UDim.new(0, 9)
            bCorner.Parent = switch

            -- Full Overlay Button (Makes the entire row clickable)
            local clickArea = Instance.new("TextButton")
            clickArea.Parent = frame
            clickArea.Size = UDim2.new(1, 0, 1, 0)
            clickArea.BackgroundTransparency = 1
            clickArea.Text = ""

            local state = false
            clickArea.MouseButton1Click:Connect(function()
                state = not state
                if state then
                    switch.BackgroundColor3 = Color3.fromRGB(110, 85, 235)
                else
                    switch.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
                end
                callback(state)
            end)
        end

        function components:TextBox(placeholder, callback)
            local box = Instance.new("TextBox")
            box.Parent = tabContainer
            box.Size = UDim2.new(1, -6, 0, 32)
            box.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
            box.PlaceholderText = placeholder
            box.PlaceholderColor3 = Color3.fromRGB(120, 120, 140)
            box.Text = ""
            box.TextColor3 = Color3.fromRGB(255, 255, 255)
            box.Font = Enum.Font.Gotham
            box.TextSize = 11

            local bCorner = Instance.new("UICorner")
            bCorner.CornerRadius = UDim.new(0, 6)
            bCorner.Parent = box

            box.FocusLost:Connect(function()
                callback(box.Text)
            end)
        end

        function components:Button(text, callback)
            local btn = Instance.new("TextButton")
            btn.Parent = tabContainer
            btn.Size = UDim2.new(1, -6, 0, 32)
            btn.BackgroundColor3 = Color3.fromRGB(110, 85, 235)
            btn.Text = text
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Font = Enum.Font.GothamBold
            btn.TextSize = 11

            local bCorner = Instance.new("UICorner")
            bCorner.CornerRadius = UDim.new(0, 6)
            bCorner.Parent = btn

            btn.MouseButton1Click:Connect(function()
                callback()
            end)
        end

        return components
    end

    -- Tab Instantiation
    local MainTab = CreateTab("Hitbox")
    local FeedbackTab = CreateTab("Feedback")

    -- Hitbox Tab Controls
    MainTab:Toggle("Status", function(state)
        getgenv().HitboxStatus = state
    end)

    MainTab:Toggle("Team Check", function(state)
        getgenv().TeamCheck = state
    end)

    MainTab:Toggle("Target Good Aliens", function(state)
        getgenv().TargetGoodAliens = state
    end)

    MainTab:TextBox("Hitbox Size (Default: 10)", function(val)
        local num = tonumber(val)
        if num and num > 0 then
            getgenv().HitboxSize = num
        end
    end)

    MainTab:TextBox("Transparency 0-1 (Default: 0.9)", function(val)
        local num = tonumber(val)
        if num then
            getgenv().HitboxTransparency = math.clamp(num, 0, 1)
        end
    end)

    -- Feedback Tab Controls
    FeedbackTab:Button("Open Feedback Menu", function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/ujerald789/FB/main/FB"))()
    end)

    -- Keyboard Keybind Support (F)
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Enum.KeyCode.F then
            Window.Visible = not Window.Visible
        end
    end)

    -- Target Loop
    RunService.RenderStepped:Connect(function()
        local localPlayer = Players.LocalPlayer
        local statusEffects = game:GetService("ReplicatedStorage"):FindFirstChild("ReplicatedStatusEffects")

        local myTeamName = localPlayer.Team and string.lower(localPlayer.Team.Name) or ""
        local amIAlien = string.find(myTeamName, "alien") ~= nil

        for _, v in ipairs(Players:GetPlayers()) do
            if v ~= localPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = v.Character.HumanoidRootPart
                
                if getgenv().HitboxStatus then
                    local shouldExpand = false

                    if not getgenv().TeamCheck then
                        shouldExpand = true
                    else
                        local targetTeamName = v.Team and string.lower(v.Team.Name) or ""
                        local isTargetAlien = string.find(targetTeamName, "alien") ~= nil

                        if amIAlien then
                            if not isTargetAlien then
                                shouldExpand = true
                            end
                        else
                            if isTargetAlien then
                                local isRebelRS = false
                                if statusEffects and statusEffects:FindFirstChild(v.Name) then
                                    if statusEffects[v.Name]:FindFirstChild("REBEL") then
                                        isRebelRS = true
                                    end
                                end

                                local isRebelCharacter = false
                                if hrp:FindFirstChild("RebelBillBoardGui") then
                                    isRebelCharacter = true
                                end

                                local isRebel = isRebelRS or isRebelCharacter

                                if isRebel or getgenv().TargetGoodAliens then
                                    shouldExpand = true
                                end
                            else
                                if localPlayer.Team ~= v.Team then
                                    shouldExpand = true
                                end
                            end
                        end
                    end

                    if shouldExpand then
                        pcall(function()
                            hrp.Size = Vector3.new(getgenv().HitboxSize, getgenv().HitboxSize, getgenv().HitboxSize)
                            hrp.Transparency = getgenv().HitboxTransparency
                            hrp.BrickColor = BrickColor.new("Really black")
                            hrp.Material = Enum.Material.Neon
                            hrp.CanCollide = false
                        end)
                    else
                        pcall(function()
                            hrp.Size = Vector3.new(2, 2, 1)
                            hrp.Transparency = 1
                            hrp.BrickColor = BrickColor.new("Medium stone grey")
                            hrp.Material = Enum.Material.Plastic
                            hrp.CanCollide = false
                        end)
                    end
                else
                    pcall(function()
                        hrp.Size = Vector3.new(2, 2, 1)
                        hrp.Transparency = 1
                        hrp.BrickColor = BrickColor.new("Medium stone grey")
                        hrp.Material = Enum.Material.Plastic
                        hrp.CanCollide = false
                    end)
                end
            end
        end
    end)
end

