-- Function to apply consistent dark styling and rounded corners
local function styleButton(btn, text, bgColor, txtColor)
	btn.BackgroundColor3 = bgColor or Color3.fromRGB(28, 28, 28)
	btn.TextColor3 = txtColor or Color3.fromRGB(215, 215, 215)
	btn.Font = Enum.Font.SourceSansBold
	btn.Text = text
	btn.BorderSizePixel = 0
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = btn
end

