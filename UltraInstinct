local function forceFaceDirection(directionVector, duration)
	if not humanoid or not hrp then return end


	humanoid.AutoRotate = false


	local lookDir = Vector3.new(directionVector.X, 0, directionVector.Z).Unit
	if lookDir.Magnitude == 0 then return end


	hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + lookDir)

	task.delay(duration, function()
		if humanoid then
			humanoid.AutoRotate = true
		end
	end)
end

local lastDodgeDirection = 1

local function dodge()
	if not canDodge or not humanoid or humanoid.Health <= 0 then return end
	canDodge = false

	emitDodgeVFX()

	local direction = -lastDodgeDirection
	lastDodgeDirection = direction

	local offset = hrp.CFrame.RightVector * instinctoffset * direction
	local targetCFrame = hrp.CFrame + offset

	local track = direction == -1 and leftTrack or rightTrack
	if track then
		track:Play()
	end

	local sound = dodgeSounds[currentSoundIndex]
	if sound then
		sound:Play()

		currentSoundIndex += 1
		if currentSoundIndex > #dodgeSounds then
			currentSoundIndex = 1
		end
	end

	local dodgeTween = TweenService:Create(
		hrp,
		TweenInfo.new(instincttime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ CFrame = targetCFrame }
	)
	dodgeTween:Play()


	task.delay(instincttime, function()
		if humanoid and hrp then
			local dodgeVector = hrp.CFrame.RightVector * direction
			forceFaceDirection(-dodgeVector, 0.3)


			if track and track.IsPlaying then
				track:Stop(0)
			end
		end
	end)

	task.delay(instinctcooldown, function()
		canDodge = true
	end)
end





local partPreviousPositions = {}

RunService.Heartbeat:Connect(function(deltaTime)
	if not dodgeEnabled or not character or not hrp then return end

	local region = Region3.new(
		hrp.Position - Vector3.new(instinctdetectdistance, instinctdetectdistance, instinctdetectdistance),
		hrp.Position + Vector3.new(instinctdetectdistance, instinctdetectdistance, instinctdetectdistance)
	)

	local parts = workspace:FindPartsInRegion3(region, character, math.huge)

	for _, part in ipairs(parts) do
		local prevPos = partPreviousPositions[part]
		local velocity = 0

		if prevPos then

			local distance = (part.Position - prevPos).Magnitude
			velocity = distance / deltaTime
		end


		partPreviousPositions[part] = part.Position


		if velocity >= 9 then
			dodge()
			break
		end
	end
end)





