_G.auto = true

-- Cache the local player
local player = game:GetService("Players").LocalPlayer

while _G.auto do
    task.wait(1) -- Faster response than 3 seconds
    
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    -- Safety check: ensure character exists and is alive
    if hrp then
        local targetName = "Collect"
        local closest = nil
        local dist = math.huge

        -- Optimization: Only scan workspace if necessary, 
        -- but ideally, replace 'workspace' with a specific folder
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name == targetName then
                local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
                
                if part then
                    local d = (hrp.Position - part.Position).Magnitude
                    if d < dist then
                        dist = d
                        closest = obj
                    end
                end
            end
        end

        if closest then
            -- Create a list of all parts to touch (the object itself + children)
            local targets = closest:IsA("BasePart") and {closest} or {}
            for _, v in ipairs(closest:GetDescendants()) do
                if v:IsA("BasePart") then table.insert(targets, v) end
            end

            -- Fire touch interests
            for _, p in ipairs(targets) do
                firetouchinterest(hrp, p, 0)
                task.wait() -- Smallest possible delay
                firetouchinterest(hrp, p, 1)
            end
        end
    end
end
