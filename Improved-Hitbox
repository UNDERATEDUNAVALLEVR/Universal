-- Universal Team Check Variable
local teamCheckEnabled = true

-- Universal team detection function with Rebel Alien logic
local function isEnemy(player)
    if player == localPlayer then
        return false
    end
    
    if not teamCheckEnabled then
        return true
    end
    
    -- Alien detection check
    local isTargetAlien = false
    if player.Team and string.find(string.lower(player.Team.Name), "alien") then
        isTargetAlien = true
    elseif player.TeamColor and string.find(string.lower(tostring(player.TeamColor)), "green") then
        isTargetAlien = true
    end

    -- Rebel Status Check for Aliens
    if isTargetAlien then
        local isRebel = false
        
        -- Status Effects folder check
        local statusEffects = ReplicatedStorage:FindFirstChild("ReplicatedStatusEffects")
        if statusEffects then
            local rebelFolder = statusEffects:FindFirstChild("REBEL") or statusEffects:FindFirstChild("Rebel")
            if rebelFolder and rebelFolder:FindFirstChild(player.Name) then
                isRebel = true
            end
        end
        
        -- Character GUI check
        if not isRebel and player.Character then
            if player.Character:FindFirstChild("RebelBillBoardGui", true) or player.Character:FindFirstChild("Rebel", true) then
                isRebel = true
            end
        end
        
        return isRebel
    end
    
    -- Standard Team Fallbacks
    if localPlayer.Team ~= nil or player.Team ~= nil then
        return localPlayer.Team ~= player.Team
    end
    
    if localPlayer.TeamColor ~= nil and player.TeamColor ~= nil then
        return localPlayer.TeamColor ~= player.TeamColor
    end

    return true
end

